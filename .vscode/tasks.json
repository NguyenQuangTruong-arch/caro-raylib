{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Caro Raylib",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/gcc.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-std=c99",
                "-g",

                "${workspaceFolder}/main.c",
                "${workspaceFolder}/src/game.c",
                "${workspaceFolder}/src/menu.c",
                "${workspaceFolder}/src/save_browser.c",


                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}/external/raylib/include",
                "-L${workspaceFolder}/external/raylib/lib",

                "-o",
                "${workspaceFolder}/caro.exe",

                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}